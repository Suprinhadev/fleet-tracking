# Copy this file to .env.local for local development.
PORT=3000
CORS_ORIGINS=http://localhost:3001,https://your-frontend.vercel.app
TRACCAR_API_URL=https://fleet.aiconnect.co.mz
TRACCAR_EMAIL=replace@example.com
TRACCAR_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
SUPABASE_URL=https://replace-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
# Optional webhook receivers for Traccar events; the receiver must return a 2xx response.
# Failed deliveries retry after 1m, 5m, 15m, and 60m, then stop after five attempts.
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
